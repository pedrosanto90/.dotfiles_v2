#!/usr/bin/env bash
set -euo pipefail

readonly runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly state_home="${XDG_STATE_HOME:-${HOME}/.local/state}/debian-sway-dev"
readonly config_file="${state_home}/pomodoro.conf"
readonly state_file="${runtime_dir}/debian-sway-dev-pomodoro.state"
readonly pid_file="${runtime_dir}/debian-sway-dev-pomodoro.pid"
readonly lock_file="${runtime_dir}/debian-sway-dev-pomodoro.lock"

readonly icon_idle='󰔟'
readonly icon_focus='󰔛'
readonly icon_break='󰅊'
readonly icon_paused='󰏤'

readonly default_focus=50
readonly default_short=10
readonly default_long=15
readonly cycle_length=4

notify_error() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send --urgency=critical 'Pomodoro' "$1" || true
}

send_notification() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "$1" "$2" || true
}

# Send a notification whose default action runs a subcommand when invoked
# (right-click on the Mako notification). Runs detached so the caller is not
# blocked by --wait; fd 9 is closed so the state flock is never inherited.
spawn_action_notification() {
  local label=$1 title=$2 body=$3 action=$4
  command -v notify-send >/dev/null 2>&1 || return 0
  setsid "${BASH_SOURCE[0]}" notify-action "${label}" "${title}" "${body}" "${action}" \
    >/dev/null 2>&1 9>&- &
}

refresh_waybar() {
  pkill -RTMIN+10 -x waybar 2>/dev/null || true
}

# Mutations run inside a subshell so the flock is always released on return.
with_lock() {
  mkdir -p "${runtime_dir}"
  (
    flock 9 || exit 1
    "$@"
  ) 9>"${lock_file}"
}

read_durations() {
  dur_focus=${default_focus}
  dur_short=${default_short}
  dur_long=${default_long}
  [[ -r ${config_file} ]] || return 0

  local key value
  while IFS='=' read -r key value; do
    [[ ${value} =~ ^[0-9]+$ ]] || continue
    (( value > 0 )) || continue
    case ${key} in
      focus) dur_focus=${value} ;;
      short) dur_short=${value} ;;
      long) dur_long=${value} ;;
    esac
  done <"${config_file}"
}

read_state() {
  phase=''
  ends_at=0
  remaining=0
  sessions=0
  [[ -r ${state_file} ]] || return 0

  local key value
  while IFS='=' read -r key value; do
    case ${key} in
      phase)
        if [[ ${value} =~ ^(focus|short|long)$ ]]; then
          phase=${value}
        fi
        ;;
      ends_at)
        if [[ ${value} =~ ^[0-9]+$ ]]; then
          ends_at=${value}
        fi
        ;;
      remaining)
        if [[ ${value} =~ ^[0-9]+$ ]]; then
          remaining=${value}
        fi
        ;;
      sessions)
        if [[ ${value} =~ ^[0-9]+$ ]]; then
          sessions=${value}
        fi
        ;;
    esac
  done <"${state_file}"
}

write_state() {
  mkdir -p "${runtime_dir}"
  local temporary
  temporary=$(mktemp "${runtime_dir}/.pomodoro.state.XXXXXX")
  printf 'phase=%s\nends_at=%s\nremaining=%s\nsessions=%s\n' \
    "${phase}" "${ends_at}" "${remaining}" "${sessions}" >"${temporary}"
  mv -f -- "${temporary}" "${state_file}"
}

phase_label() {
  case $1 in
    focus) printf 'Focus' ;;
    short) printf 'Short break' ;;
    long) printf 'Long break' ;;
  esac
}

phase_description() {
  case $1 in
    focus) printf 'focus session' ;;
    short) printf 'short break' ;;
    long) printf 'long break' ;;
  esac
}

phase_minutes() {
  read_durations
  case $1 in
    focus) printf '%s' "${dur_focus}" ;;
    short) printf '%s' "${dur_short}" ;;
    long) printf '%s' "${dur_long}" ;;
  esac
}

phase_seconds() {
  local minutes
  minutes=$(phase_minutes "$1")
  printf '%s' "$(( minutes * 60 ))"
}

format_time() {
  local total=$1 hours minutes seconds
  hours=$(( total / 3600 ))
  minutes=$(( (total % 3600) / 60 ))
  seconds=$(( total % 60 ))
  if (( hours > 0 )); then
    printf '%d:%02d:%02d' "${hours}" "${minutes}" "${seconds}"
  else
    printf '%02d:%02d' "${minutes}" "${seconds}"
  fi
}

start_phase() {
  local new_phase=$1 new_sessions=${2:-0} override=${3:-}
  local seconds
  if [[ ${override} =~ ^[0-9]+$ ]] && (( override > 0 )); then
    seconds=${override}
  else
    seconds=$(phase_seconds "${new_phase}")
  fi
  phase=${new_phase}
  sessions=${new_sessions}
  ends_at=$(( $(date +%s) + seconds ))
  remaining=0
  write_state
}

watcher_alive() {
  local pid=''
  [[ -r ${pid_file} ]] || return 1
  read -r pid <"${pid_file}"
  [[ ${pid} =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null
}

ensure_watcher() {
  watcher_alive && return 0
  read_state
  (( ends_at > 0 )) || return 0
  # Close the inherited lock descriptor so the watcher never holds it.
  setsid "${BASH_SOURCE[0]}" watch >/dev/null 2>&1 9>&- &
}

run_watcher() {
  printf '%s\n' "$$" >"${pid_file}"

  local now recorded
  while true; do
    sleep 1
    [[ -r ${state_file} ]] || break
    read_state
    [[ -n ${phase} ]] || break
    (( ends_at > 0 )) || continue

    now=$(date +%s)
    (( now >= ends_at )) || continue
    with_lock cmd_transition
  done

  recorded=''
  [[ -r ${pid_file} ]] && read -r recorded <"${pid_file}"
  if [[ ${recorded} == "$$" ]]; then
    rm -f -- "${pid_file}"
  fi
  return 0
}

cmd_transition() {
  read_state
  [[ -n ${phase} ]] || return 0

  local finished=${phase} next
  case ${finished} in
    focus)
      sessions=$(( sessions + 1 ))
      if (( sessions % cycle_length == 0 )); then
        next=long
      else
        next=short
      fi
      ;;
    *) next=focus ;;
  esac

  start_phase "${next}" "${sessions}"
  notify_transition "${finished}" "${next}" "${sessions}"
  refresh_waybar
}

notify_transition() {
  local finished=$1 next=$2 count=$3 minutes body
  if [[ ${finished} == focus ]]; then
    minutes=$(phase_minutes "${next}")
    body=$(printf 'Session %s complete. Take a %s for %s min.' \
      "${count}" "$(phase_description "${next}")" "${minutes}")
    spawn_action_notification 'Skip break' 'Pomodoro — focus complete' \
      "${body}" cmd_skip
  else
    minutes=$(phase_minutes focus)
    send_notification 'Pomodoro — break complete' \
      "$(printf 'Focus again for %s min.' "${minutes}")"
  fi
}

cmd_start() {
  local minutes=${1:-}
  read_durations

  local override='' display_minutes
  if [[ ${minutes} =~ ^[0-9]+$ ]] && (( minutes > 0 )); then
    override=$(( minutes * 60 ))
    display_minutes=${minutes}
  else
    display_minutes=${dur_focus}
  fi

  sessions=0
  start_phase focus 0 "${override}"
  ensure_watcher
  send_notification 'Pomodoro — focus started' \
    "$(printf '%s min focus session.' "${display_minutes}")"
  refresh_waybar
}

cmd_toggle() {
  read_state
  if [[ -z ${phase} ]]; then
    cmd_start
  elif (( ends_at > 0 )); then
    cmd_pause
  else
    cmd_resume
  fi
}

cmd_pause() {
  read_state
  [[ -n ${phase} ]] || return 0
  (( ends_at > 0 )) || return 0

  local now
  now=$(date +%s)
  remaining=$(( ends_at - now ))
  (( remaining > 0 )) || remaining=0
  ends_at=0
  write_state
  refresh_waybar
}

cmd_resume() {
  read_state
  [[ -n ${phase} ]] || return 0
  (( ends_at == 0 )) || return 0

  if (( remaining <= 0 )); then
    remaining=$(phase_seconds "${phase}")
  fi
  ends_at=$(( $(date +%s) + remaining ))
  remaining=0
  write_state
  ensure_watcher
  refresh_waybar
}

cmd_skip() {
  read_state
  if [[ -z ${phase} ]]; then
    cmd_start
    return
  fi

  local next
  case ${phase} in
    focus) next=short ;;
    *) next=focus ;;
  esac

  start_phase "${next}" "${sessions}"
  ensure_watcher
  send_notification 'Pomodoro' \
    "$(printf 'Skipped to: %s.' "$(phase_label "${next}")")"
  refresh_waybar
}

cmd_stop() {
  local pid=''
  if [[ -r ${pid_file} ]]; then
    read -r pid <"${pid_file}"
  fi
  if [[ ${pid} =~ ^[0-9]+$ ]]; then
    kill "${pid}" 2>/dev/null || true
  fi
  rm -f -- "${pid_file}" "${state_file}"
  send_notification 'Pomodoro' 'Timer stopped.'
  refresh_waybar
}

cmd_notify_action() {
  local label=$1 title=$2 body=$3 action=$4 choice=''
  command -v notify-send >/dev/null 2>&1 || return 0

  choice=$(notify-send --wait --action="default=${label}" "${title}" "${body}" 2>/dev/null) || true
  if [[ ${choice} == default ]]; then
    with_lock "${action}"
  fi
}

cmd_set_durations() {
  local focus=$1 short=$2 long=$3 value
  for value in "${focus}" "${short}" "${long}"; do
    [[ ${value} =~ ^[0-9]+$ ]] && (( value > 0 )) || return 1
  done

  mkdir -p "${state_home}"
  local temporary
  temporary=$(mktemp "${state_home}/.pomodoro.conf.XXXXXX")
  printf 'focus=%s\nshort=%s\nlong=%s\n' \
    "${focus}" "${short}" "${long}" >"${temporary}"
  mv -f -- "${temporary}" "${config_file}"
}

print_status() {
  read_state
  read_durations

  local icon class click_hint session_info tooltip
  if [[ -z ${phase} ]]; then
    printf '{"text":"%s","class":"idle","tooltip":"Pomodoro stopped\\nClick: start focus (%s min) · Right-click: menu · Super+P"}\n' \
      "${icon_idle}" "${dur_focus}"
    return 0
  fi

  if (( ends_at > 0 )); then
    ensure_watcher
    now=$(date +%s)
    remaining=$(( ends_at - now ))
    (( remaining > 0 )) || remaining=0
    if [[ ${phase} == focus ]]; then
      icon=${icon_focus}
      class=running
    else
      icon=${icon_break}
      class=break
    fi
    click_hint='pause'
  else
    icon=${icon_paused}
    class=paused
    click_hint='resume'
  fi

  session_info=$(printf '%s completed (long break every %s)' \
    "${sessions}" "${cycle_length}")

  printf '{"text":"%s %s","class":"%s","tooltip":"%s — %s\\nSessions: %s\\nClick: %s · Right-click: menu · Super+P"}\n' \
    "${icon}" "$(format_time "${remaining}")" "${class}" \
    "$(phase_label "${phase}")" "$(format_time "${remaining}")" \
    "${session_info}" "${click_hint}"
}

menu_gui() {
  local script_dir
  script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
  local gui="${script_dir}/pomodoro-gtk"
  if [[ ! -x ${gui} ]]; then
    gui=$(command -v pomodoro-gtk 2>/dev/null || true)
  fi
  [[ -n ${gui} && -x ${gui} ]] || {
    notify_error 'The Pomodoro graphical menu is not installed.'
    return 1
  }
  [[ -n ${WAYLAND_DISPLAY:-} ]] || {
    notify_error 'A Wayland session is required to open the menu.'
    return 1
  }

  # Skip if a menu window is already open so repeated invocations do not stack.
  if command -v swaymsg >/dev/null 2>&1 &&
    swaymsg -t get_tree -r 2>/dev/null |
    jq -e '.. | objects | select(.app_id? == "dev.debianswaydev.pomodoro")' >/dev/null 2>&1; then
    return 0
  fi
  setsid "${gui}" >/dev/null 2>&1 &
}

cmd_menu() {
  menu_gui
}

case ${1:-status} in
  status)
    print_status
    ;;
  toggle)
    with_lock cmd_toggle
    ;;
  start)
    with_lock cmd_start "${2:-}"
    ;;
  pause)
    with_lock cmd_pause
    ;;
  resume)
    with_lock cmd_resume
    ;;
  skip)
    with_lock cmd_skip
    ;;
  stop)
    with_lock cmd_stop
    ;;
  menu)
    cmd_menu
    ;;
  set-durations)
    with_lock cmd_set_durations "${2:-}" "${3:-}" "${4:-}"
    ;;
  notify-action)
    cmd_notify_action "${2:-}" "${3:-}" "${4:-}" "${5:-}"
    ;;
  watch)
    run_watcher
    ;;
  *)
    printf 'Usage: %s [status|toggle|start [minutes]|pause|resume|skip|stop|menu|set-durations focus short long]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
