#!/usr/bin/env bash
set -euo pipefail

readonly state_home="${XDG_STATE_HOME:-${HOME}/.local/state}/debian-sway-dev"
readonly runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly state_file="${state_home}/theme"
readonly lock_file="${runtime_dir}/debian-sway-dev-theme.lock"
readonly themes_dir="${HOME}/.local/share/themes"
readonly waybar_dir="${HOME}/.config/waybar"
readonly ghostty_dir="${HOME}/.config/ghostty"
readonly ghostty_theme_file="${ghostty_dir}/current-theme.conf"
readonly tmux_dir="${HOME}/.config/tmux"
readonly tmux_theme_file="${tmux_dir}/current-theme.conf"
readonly vscodium_settings="${HOME}/.config/VSCodium/User/settings.json"

is_theme() {
  case ${1:-} in
    tokyonight-dark | tokyonight-light | kanagawa-dark | kanagawa-light | \
      rose-pine-dark | everforest-dark | everforest-light | catppuccin-dark | nightfox-dark) return 0 ;;
    *) return 1 ;;
  esac
}

current_theme() {
  local selected=''
  if [[ -r ${state_file} ]]; then
    read -r selected <"${state_file}"
  fi
  if is_theme "${selected}"; then
    printf '%s\n' "${selected}"
    return
  fi

  if [[ ${selected} == light || ${selected} == dark ]]; then
    printf 'tokyonight-%s\n' "${selected}"
    return
  fi

  if command -v gsettings >/dev/null 2>&1; then
    selected=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)
    [[ ${selected} == *prefer-light* ]] && selected=light || selected=dark
  else
    selected=dark
  fi
  printf 'tokyonight-%s\n' "${selected}"
}

theme_family() {
  printf '%s\n' "${1%-*}"
}

theme_mode() {
  printf '%s\n' "${1##*-}"
}

theme_label() {
  case $1 in
    tokyonight-dark) printf 'Tokyo Night — Dark' ;;
    tokyonight-light) printf 'Tokyo Night — Light' ;;
    kanagawa-dark) printf 'Kanagawa — Wave (Dark)' ;;
    kanagawa-light) printf 'Kanagawa — Lotus (Light)' ;;
    rose-pine-dark) printf 'Rosé Pine — Dark' ;;
    everforest-dark) printf 'Everforest — Dark' ;;
    everforest-light) printf 'Everforest — Light' ;;
    catppuccin-dark) printf 'Catppuccin — Mocha' ;;
    nightfox-dark) printf 'Nightfox — Dark' ;;
  esac
}

print_themes() {
  theme_label tokyonight-dark
  printf '\n'
  theme_label tokyonight-light
  printf '\n'
  theme_label kanagawa-dark
  printf '\n'
  theme_label kanagawa-light
  printf '\n'
  theme_label rose-pine-dark
  printf '\n'
  theme_label everforest-dark
  printf '\n'
  theme_label everforest-light
  printf '\n'
  theme_label catppuccin-dark
  printf '\n'
  theme_label nightfox-dark
  printf '\n'
}

print_status() {
  local selected family mode label icon hint
  selected=$(current_theme)
  family=$(theme_family "${selected}")
  mode=$(theme_mode "${selected}")
  label=$(theme_label "${selected}")
  [[ ${mode} == light ]] && icon='󰖨' || icon='󰖔'
  case ${family} in
    rose-pine | catppuccin | nightfox) hint='Click: choose theme · Dark-only family' ;;
    *) hint='Click: choose theme · Right-click: toggle light/dark' ;;
  esac
  printf '{"text":"%s","class":"%s","tooltip":"%s\\n%s"}\n' \
    "${icon}" "${family}-${mode}" "${label}" "${hint}"
}

notify_error() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send --urgency=critical 'Não foi possível mudar o tema' "$1" || true
}

write_gtk_settings() {
  local destination=$1 theme=$2 icons=$3 prefer_dark=$4 temporary
  mkdir -p "$(dirname -- "${destination}")"
  temporary=$(mktemp "$(dirname -- "${destination}")/.settings.ini.XXXXXX")
  printf '[Settings]\ngtk-theme-name=%s\ngtk-icon-theme-name=%s\ngtk-application-prefer-dark-theme=%s\n' \
    "${theme}" "${icons}" "${prefer_dark}" >"${temporary}"
  mv -f -- "${temporary}" "${destination}"
}

replace_symlink() {
  local target=$1 link=$2 temporary
  if [[ -e ${link} && ! -L ${link} ]]; then
    printf 'Refusing to replace non-symlink path: %s\n' "${link}" >&2
    return 1
  fi
  temporary="${link}.theme-toggle.$$"
  ln -s -- "${target}" "${temporary}"
  mv -Tf -- "${temporary}" "${link}"
}

write_ghostty_theme() {
  local theme=$1 background=${2:-} temporary
  mkdir -p "${ghostty_dir}"
  temporary=$(mktemp "${ghostty_dir}/.current-theme.XXXXXX")
  printf 'theme = %s\n' "${theme}" >"${temporary}"
  if [[ -n ${background} ]]; then
    printf 'background = %s\n' "${background}" >>"${temporary}"
  fi
  if command -v ghostty >/dev/null 2>&1; then
    ghostty +validate-config --config-file="${temporary}" >/dev/null
  fi
  mv -f -- "${temporary}" "${ghostty_theme_file}"
}

write_waybar_palette() {
  local palette=$1 temporary
  temporary=$(mktemp "${waybar_dir}/.colors.css.XXXXXX")
  printf '@import "%s";\n' "${palette}" >"${temporary}"
  mv -f -- "${temporary}" "${waybar_dir}/colors.css"
}

palette_color() {
  local palette_file=$1 color=$2
  awk -v color="${color}" '
    $1 == "@define-color" && $2 == color {
      value = $3
      sub(/;$/, "", value)
      print value
      found = 1
      exit
    }
    END { if (!found) exit 1 }
  ' "${palette_file}"
}

write_tmux_theme() {
  local palette_file=$1 background foreground selected muted border accent alert purple temporary
  background=$(palette_color "${palette_file}" tooltip_background)
  foreground=$(palette_color "${palette_file}" foreground)
  selected=$(palette_color "${palette_file}" selected_foreground)
  muted=$(palette_color "${palette_file}" muted)
  border=$(palette_color "${palette_file}" border)
  accent=$(palette_color "${palette_file}" blue)
  alert=$(palette_color "${palette_file}" red)
  purple=$(palette_color "${palette_file}" purple)

  mkdir -p "${tmux_dir}"
  temporary=$(mktemp "${tmux_dir}/.current-theme.XXXXXX")
  printf '%s\n' \
    "set -g status-style 'bg=${background},fg=${foreground}'" \
    "set -g message-style 'bg=${accent},fg=${selected}'" \
    "set -g message-command-style 'bg=${purple},fg=${selected}'" \
    "set -g mode-style 'bg=${accent},fg=${selected}'" \
    "set -g pane-border-style 'fg=${border}'" \
    "set -g pane-active-border-style 'fg=${accent}'" \
    "set -g window-status-style 'fg=${muted}'" \
    "set -g window-status-current-style 'bg=${accent},fg=${selected},bold'" \
    "set -g window-status-bell-style 'bg=${alert},fg=${selected},bold'" \
    "set -g status-left-style 'fg=${purple}'" \
    "set -g status-right-style 'fg=${foreground}'" >"${temporary}"
  mv -f -- "${temporary}" "${tmux_theme_file}"
}

write_vscodium_theme() {
  local theme=$1 temporary
  [[ -f ${vscodium_settings} ]] || return 0

  temporary=$(mktemp "$(dirname -- "${vscodium_settings}")/.settings.XXXXXX.json")
  if ! awk -v theme="${theme}" '
    BEGIN { found = 0 }
    /^[[:space:]]*"workbench\.colorTheme"[[:space:]]*:/ {
      indent = $0
      sub(/[^[:space:]].*$/, "", indent)
      printf "%s\"workbench.colorTheme\": \"%s\",\n", indent, theme
      found = 1
      next
    }
    { print }
    END { if (!found) exit 42 }
  ' "${vscodium_settings}" >"${temporary}"; then
    rm -f -- "${temporary}"
    notify_error 'A opção workbench.colorTheme não existe nas settings do VSCodium.'
    return 1
  fi
  chmod --reference="${vscodium_settings}" "${temporary}"

  if cmp -s "${temporary}" "${vscodium_settings}"; then
    rm -f -- "${temporary}"
  else
    mv -f -- "${temporary}" "${vscodium_settings}"
  fi
}

apply_theme() {
  local selected=$1 gtk_theme icon_theme prefer_dark color_scheme palette theme_dir ghostty_theme ghostty_background vscodium_theme temporary
  case ${selected} in
    tokyonight-dark)
      gtk_theme='Tokyonight-Dark'
      icon_theme='Papirus-Dark'
      prefer_dark=1
      color_scheme='prefer-dark'
      palette='colors-dark.css'
      ghostty_theme='TokyoNight Night'
      ghostty_background='#000000'
      vscodium_theme='Tokyo Night Storm'
      ;;
    tokyonight-light)
      gtk_theme='Tokyonight-Light'
      icon_theme='Papirus-Light'
      prefer_dark=0
      color_scheme='prefer-light'
      palette='colors-light.css'
      ghostty_theme='TokyoNight Day'
      ghostty_background=''
      vscodium_theme='Tokyo Night Light'
      ;;
    kanagawa-dark)
      gtk_theme='Kanagawa-Dark'
      icon_theme='Papirus-Dark'
      prefer_dark=1
      color_scheme='prefer-dark'
      palette='colors-kanagawa-dark.css'
      ghostty_theme='Kanagawa Wave'
      ghostty_background='#000000'
      vscodium_theme='Kanagawa Wave'
      ;;
    kanagawa-light)
      gtk_theme='Kanagawa-Light'
      icon_theme='Papirus-Light'
      prefer_dark=0
      color_scheme='prefer-light'
      palette='colors-kanagawa-light.css'
      ghostty_theme='Kanagawa Lotus'
      ghostty_background=''
      vscodium_theme='Kanagawa Lotus'
      ;;
    rose-pine-dark)
      gtk_theme='Rose-Pine-Dark'
      icon_theme='Papirus-Dark'
      prefer_dark=1
      color_scheme='prefer-dark'
      palette='colors-rose-pine-dark.css'
      ghostty_theme='Rose Pine'
      ghostty_background=''
      vscodium_theme='Rosé Pine'
      ;;
    everforest-dark)
      gtk_theme='Everforest-Dark'
      icon_theme='Papirus-Dark'
      prefer_dark=1
      color_scheme='prefer-dark'
      palette='colors-everforest-dark.css'
      ghostty_theme='Everforest Dark Hard'
      ghostty_background=''
      vscodium_theme='Everforest Night Hard'
      ;;
    everforest-light)
      gtk_theme='Everforest-Light'
      icon_theme='Papirus-Light'
      prefer_dark=0
      color_scheme='prefer-light'
      palette='colors-everforest-light.css'
      ghostty_theme='Everforest Light Med'
      ghostty_background=''
      vscodium_theme='Everforest Night Light Hard'
      ;;
    catppuccin-dark)
      gtk_theme='Catppuccin-Dark'
      icon_theme='Papirus-Dark'
      prefer_dark=1
      color_scheme='prefer-dark'
      palette='colors-catppuccin-mocha.css'
      ghostty_theme='Catppuccin Mocha'
      ghostty_background=''
      vscodium_theme='Catppuccin Mocha'
      ;;
    nightfox-dark)
      gtk_theme='Nightfox-Dark'
      icon_theme='Papirus-Dark'
      prefer_dark=1
      color_scheme='prefer-dark'
      palette='colors-nightfox-dark.css'
      ghostty_theme='Nightfox'
      ghostty_background=''
      vscodium_theme='Nightfox'
      ;;
    *)
      printf 'Unknown theme: %s\n' "${selected}" >&2
      return 2
      ;;
  esac

  theme_dir="${themes_dir}/${gtk_theme}"
  [[ -f ${theme_dir}/gtk-3.0/gtk.css && -f ${theme_dir}/gtk-4.0/gtk.css ]] || {
    notify_error "O tema ${gtk_theme} não está instalado. Executa novamente ./install.sh."
    return 1
  }
  [[ -f ${waybar_dir}/${palette} ]] || {
    notify_error "A paleta ${palette} da Waybar não está instalada."
    return 1
  }
  for link in \
    "${HOME}/.config/gtk-4.0/assets" \
    "${HOME}/.config/gtk-4.0/gtk.css" \
    "${HOME}/.config/gtk-4.0/gtk-dark.css"; do
    if [[ -e ${link} && ! -L ${link} ]]; then
      notify_error "O caminho ${link} existe e não é uma ligação simbólica."
      return 1
    fi
  done

  write_gtk_settings "${HOME}/.config/gtk-3.0/settings.ini" "${gtk_theme}" "${icon_theme}" "${prefer_dark}"
  write_gtk_settings "${HOME}/.config/gtk-4.0/settings.ini" "${gtk_theme}" "${icon_theme}" "${prefer_dark}"
  replace_symlink "${theme_dir}/gtk-4.0/assets" "${HOME}/.config/gtk-4.0/assets"
  replace_symlink "${theme_dir}/gtk-4.0/gtk.css" "${HOME}/.config/gtk-4.0/gtk.css"
  replace_symlink "${theme_dir}/gtk-4.0/gtk-dark.css" "${HOME}/.config/gtk-4.0/gtk-dark.css"
  write_ghostty_theme "${ghostty_theme}" "${ghostty_background}"
  write_tmux_theme "${waybar_dir}/${palette}"
  write_vscodium_theme "${vscodium_theme}"

  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme "${color_scheme}" || true
    gsettings set org.gnome.desktop.interface gtk-theme "${gtk_theme}" || true
    gsettings set org.gnome.desktop.interface icon-theme "${icon_theme}" || true
  fi

  write_waybar_palette "${palette}"
  mkdir -p "${state_home}"
  temporary=$(mktemp "${state_home}/.theme.XXXXXX")
  printf '%s\n' "${selected}" >"${temporary}"
  mv -f -- "${temporary}" "${state_file}"
}

refresh_neovim() {
  local socket socket_dir="${runtime_dir}/debian-sway-dev-nvim"
  command -v nvim >/dev/null 2>&1 && [[ -d ${socket_dir} ]] || return 0

  shopt -s nullglob
  for socket in "${socket_dir}"/*.sock; do
    if ! timeout 2 nvim --server "${socket}" \
      --remote-expr 'luaeval("require(\"pedro.core.desktop-theme\").apply()")' \
      >/dev/null 2>&1; then
      rm -f -- "${socket}"
    fi
  done
  shopt -u nullglob
}

refresh_ghostty() {
  command -v ghostty >/dev/null 2>&1 || return 0
  if systemctl --user is-active --quiet app-com.mitchellh.ghostty.service 2>/dev/null; then
    systemctl --user reload app-com.mitchellh.ghostty.service || true
  else
    pkill -USR2 -x ghostty 2>/dev/null || true
  fi
}

refresh_tmux() {
  command -v tmux >/dev/null 2>&1 || return 0
  tmux list-sessions >/dev/null 2>&1 || return 0
  tmux source-file "${tmux_theme_file}"
}

stop_waybar() {
  local attempt
  pkill -TERM -x waybar 2>/dev/null || true
  for attempt in {1..40}; do
    pgrep -x waybar >/dev/null 2>&1 || return 0
    sleep 0.05
  done
  pkill -KILL -x waybar 2>/dev/null || true
  for attempt in {1..20}; do
    pgrep -x waybar >/dev/null 2>&1 || return 0
    sleep 0.05
  done
  return 1
}

restart_waybar() {
  local attempt count
  command -v swaymsg >/dev/null 2>&1 && [[ -n ${SWAYSOCK:-} ]] || {
    notify_error 'Não existe uma sessão Sway ativa para reiniciar a Waybar.'
    return 1
  }

  for attempt in 1 2; do
    stop_waybar || break
    swaymsg exec waybar >/dev/null
    for _ in {1..60}; do
      count=$(pgrep -xc waybar 2>/dev/null || true)
      [[ ${count} == 1 ]] && return 0
      [[ ${count} -gt 1 ]] && break
      sleep 0.05
    done
  done

  stop_waybar || true
  notify_error 'A Waybar não reiniciou com uma única instância.'
  return 1
}

select_mode() {
  local requested=$1 selected family mode
  selected=$(current_theme)
  family=$(theme_family "${selected}")
  mode=$(theme_mode "${selected}")
  case ${family} in
    rose-pine | catppuccin | nightfox)
      printf '%s-dark\n' "${family}"
      return
      ;;
  esac
  case ${requested} in
    toggle)
      [[ ${mode} == dark ]] && mode=light || mode=dark
      printf '%s-%s\n' "${family}" "${mode}"
      ;;
    dark | light)
      printf '%s-%s\n' "${family}" "${requested}"
      ;;
  esac
}

choose_theme() {
  local selection
  command -v wofi >/dev/null 2>&1 || {
    notify_error 'O Wofi não está instalado.'
    return 1
  }
  selection=$(print_themes | wofi --dmenu --prompt 'Theme' --width 440 --height 420 || true)
  case ${selection} in
    'Tokyo Night — Dark') printf 'tokyonight-dark\n' ;;
    'Tokyo Night — Light') printf 'tokyonight-light\n' ;;
    'Kanagawa — Wave (Dark)') printf 'kanagawa-dark\n' ;;
    'Kanagawa — Lotus (Light)') printf 'kanagawa-light\n' ;;
    'Rosé Pine — Dark') printf 'rose-pine-dark\n' ;;
    'Everforest — Dark') printf 'everforest-dark\n' ;;
    'Everforest — Light') printf 'everforest-light\n' ;;
    'Catppuccin — Mocha') printf 'catppuccin-dark\n' ;;
    'Nightfox — Dark') printf 'nightfox-dark\n' ;;
    '') return 1 ;;
    *) notify_error "Tema desconhecido: ${selection}"; return 1 ;;
  esac
}

run_selection() {
  local selected=$1
  apply_theme "${selected}"
  refresh_neovim
  refresh_ghostty
  refresh_tmux
  restart_waybar
}

case ${1:-status} in
  status)
    print_status
    ;;
  list)
    print_themes
    ;;
  initialize)
    mkdir -p "${runtime_dir}"
    exec 9>"${lock_file}"
    flock -n 9 || exit 0
    if [[ -r ${state_file} ]]; then
      selected=$(current_theme)
    else
      selected=tokyonight-dark
    fi
    apply_theme "${selected}"
    ;;
  menu)
    selected=$(choose_theme) || exit 0
    mkdir -p "${runtime_dir}"
    exec 9>"${lock_file}"
    flock -n 9 || exit 0
    run_selection "${selected}"
    ;;
  toggle | dark | light)
    mkdir -p "${runtime_dir}"
    exec 9>"${lock_file}"
    flock -n 9 || exit 0
    selected=$(select_mode "$1")
    run_selection "${selected}"
    ;;
  tokyonight-dark | tokyonight-light | kanagawa-dark | kanagawa-light | \
    rose-pine-dark | everforest-dark | everforest-light | catppuccin-dark | nightfox-dark)
    mkdir -p "${runtime_dir}"
    exec 9>"${lock_file}"
    flock -n 9 || exit 0
    run_selection "$1"
    ;;
  *)
    printf 'Usage: %s [status|list|menu|toggle|dark|light|tokyonight-dark|tokyonight-light|kanagawa-dark|kanagawa-light|rose-pine-dark|everforest-dark|everforest-light|catppuccin-dark|nightfox-dark]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
