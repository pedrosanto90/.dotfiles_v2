{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": ["sway/workspaces", "sway/window"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "disk", "pulseaudio", "battery", "tray", "custom/pomodoro", "custom/tiling", "custom/clipboard", "custom/theme", "custom/caffeine", "custom/control-center", "custom/power"],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },
  "sway/window": {
    "max-length": 60,
    "rewrite": { "(.*) — Brave": "  $1" }
  },
  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%A, %d %B %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 5
  },
  "memory": {
    "format": "  {percentage}%",
    "interval": 5
  },
  "disk": {
    "path": "/",
    "format": "  {percentage_used}%",
    "interval": 30
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": { "default": ["", "", ""] },
    "scroll-step": 0
  },
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁽", "󰁿", "󰂁", "󰁹"]
  },
  "tray": { "spacing": 8 },
  "custom/pomodoro": {
    "exec": "~/.local/bin/pomodoro status",
    "return-type": "json",
    "interval": 1,
    "signal": 10,
    "on-click": "~/.local/bin/pomodoro toggle",
    "on-click-right": "~/.local/bin/pomodoro menu"
  },
  "custom/tiling": {
    "exec": "~/.local/bin/sway-layout status",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.local/bin/sway-layout menu"
  },
  "custom/clipboard": {
    "format": "",
    "tooltip-format": "Clipboard history",
    "on-click": "~/.local/bin/clipboard-history"
  },
  "custom/theme": {
    "exec": "~/.local/bin/theme-toggle status",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "on-click": "~/.local/bin/theme-toggle menu",
    "on-click-right": "~/.local/bin/theme-toggle toggle"
  },
  "custom/caffeine": {
    "exec": "~/.local/bin/caffeine-toggle status",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/.local/bin/caffeine-toggle toggle"
  },
  "custom/control-center": {
    "format": "󰒓",
    "tooltip-format": "Control Center",
    "on-click": "~/.local/bin/control-center panel"
  },
  "custom/power": {
    "format": "",
    "tooltip-format": "Power menu",
    "on-click": "~/.local/bin/power-menu"
  }
}
