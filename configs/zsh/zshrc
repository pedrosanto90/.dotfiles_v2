# Debian Sway Dev — framework-free zsh.
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS='-R -F -X'
export PATH="${HOME}/.local/bin:${PATH}"

# Official Go toolchain.
export GOROOT=/usr/local/go
export GOPATH="${HOME}/go"
export PATH="${GOROOT}/bin:${GOPATH}/bin:${PATH}"

# NVM and Node LTS.
export NVM_DIR="${HOME}/.nvm"
[[ -s "${NVM_DIR}/nvm.sh" ]] && source "${NVM_DIR}/nvm.sh"
[[ -s "${NVM_DIR}/bash_completion" ]] && source "${NVM_DIR}/bash_completion"

# Lightweight integrations without a plugin manager.
[[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -r /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"

autoload -Uz compinit && compinit
setopt AUTO_CD HIST_IGNORE_ALL_DUPS SHARE_HISTORY
HISTFILE="${XDG_STATE_HOME:-${HOME}/.local/state}/zsh/history"
HISTSIZE=10000
SAVEHIST=10000
mkdir -p "${HISTFILE:h}"

# Open the tmux session selector with Ctrl+F.
bindkey -s '^f' 'tmux-se\n'

alias v='nvim'
alias code='codium'
alias g='git'
alias lg='lazygit'
alias t='tmux'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='rg'
command -v eza >/dev/null && alias ls='eza --icons=auto --group-directories-first' ll='eza -lah --icons=auto --git'
command -v batcat >/dev/null && alias bat='batcat'
command -v fdfind >/dev/null && alias fd='fdfind'
